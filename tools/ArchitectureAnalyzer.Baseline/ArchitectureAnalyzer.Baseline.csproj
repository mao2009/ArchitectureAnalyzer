<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArchitectureAnalyzer.BaselineTool</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>architecture-baseline</ToolCommandName>
    <PackageId>loach.ArchitectureAnalyzer.Baseline</PackageId>
    <Authors>loach</Authors>
    <Description>Generate deterministic ArchitectureAnalyzer baseline files for ratcheting legacy violations.</Description>
    <PackageTags>roslyn;analyzer;architecture;baseline;ratchet</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mao2009/ArchitectureAnalyzer</RepositoryUrl>
    <PackageProjectUrl>https://github.com/mao2009/ArchitectureAnalyzer</PackageProjectUrl>
  </PropertyGroup>

</Project>
